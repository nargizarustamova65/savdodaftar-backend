APP_NAME=Savdodaftar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=savdodaftar
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array

# SMS: log (dev) | array (test) | eskiz (production)
SMS_DRIVER=log
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

OTP_TTL=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER=60
OTP_DAILY_LIMIT=10
OTP_IP_DAILY_LIMIT=50
OTP_SMS_TEMPLATE="Savdodaftar ilovasiga kirish kodi: {code}"
# Dev uchun doimiy kod, masalan 123456 (production'da e'tiborga olinmaydi)
OTP_DEBUG_CODE=

PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=300
PIN_RESET_WINDOW=600

# Ombor
INVENTORY_ALLOW_NEGATIVE_STOCK=false
PRODUCT_IMAGE_DISK=public
PRODUCT_IMAGE_MAX_KB=4096

# Pro tarif va to'lov (TZ 31, 35, 36)
PRO_PRICE=49000
PRO_DAYS=30
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# Backup (TZ 2, 23)
BACKUP_DISK=local
BACKUP_KEEP=10
